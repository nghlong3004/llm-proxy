[Unit]
Description=Local LLM proxy for coding agents
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=%h/.local/bin/llm-proxy serve --default-model gpt-6.1-sol
Restart=on-failure
RestartSec=3
# The proxy currently handles Ctrl+C for cancellation and log flushing.
KillSignal=SIGINT
# Allow the 30s OAuth timeout plus guarded token persistence during shutdown.
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
